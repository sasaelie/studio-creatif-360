{
  "name": "studio-creatif-360",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit --incremental false",
    "check:encoding": "node scripts/check-encoding.mjs",
    "check": "npm run check:encoding && npm run build && npm run typecheck"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "next": {
      "postcss": "$postcss"
    }
  },
  "dependencies": {
    "lucide-react": "^0.292.0",
    "next": "15.5.29",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "autoprefixer": "^10.0.1",
    "postcss": "8.5.32",
    "tailwindcss": "^3.3.0",
    "typescript": "5.6.3"
  }
}
